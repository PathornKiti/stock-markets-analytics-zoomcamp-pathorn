# Copy to `.env` and fill in. `.env` is gitignored -- never commit real keys.
#   cp .env.example .env

# FRED (macro data) -- free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional: alternative data sources you may add for the project's
# "new data source" rubric point.
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=

# Optional: broker API for the project bonus point. Use PAPER trading keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
