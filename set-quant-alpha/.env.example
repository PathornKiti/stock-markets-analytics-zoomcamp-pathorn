# Copy to .env (gitignored). Everything is optional: the project runs on free, keyless sources.

# Keep the incremental data store outside the repo, e.g. a synced Google Drive folder
# SETALPHA_DATA_DIR=/Users/you/Google Drive/My Drive/set-quant-alpha-data


# LSEG Data Library app key (optional; only if you have LSEG Workspace / RDP access)
# LSEG_APP_KEY=<your-app-key>
